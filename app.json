{
  "expo": {
    "name": "Ek Ustası",
    "slug": "ek-ustasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ekustasi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131B4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ekustasi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1E2A5A"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Reklamları sana daha uygun hale getirmek için kullanılır. İzin vermesen de oyun aynı şekilde çalışır."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Reklamları sana daha uygun hale getirmek için kullanılır. İzin vermesen de oyun aynı şekilde çalışır."
        }
      ]
    ],
    "scheme": "ekustasi",
    "experiments": {
      "typedRoutes": true
    }
  }
}
